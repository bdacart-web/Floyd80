{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('games').child($code).child('hostId').val() === auth.uid)"
          }
        },
        "guesses": {
          "$round": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('games').child($code).child('hostId').val() === auth.uid)"
            }
          }
        }
      }
    }
  }
}
